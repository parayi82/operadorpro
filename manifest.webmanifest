{
  "name": "OperadorPro — La app del camionero",
  "short_name": "OperadorPro",
  "description": "Viajes, gastos, cuentas claras, papeles al día, mantenimiento del camión y cobranza. Para el chofer, el hombre-camión y el pequeño flotero.",
  "id": "/app.html",
  "start_url": "/app.html#/operador",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#17191E",
  "theme_color": "#05603A",
  "lang": "es-MX",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Reportar gasto", "url": "/app.html#/operador/gasto", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Mis cuentas", "url": "/app.html#/operador/cuentas", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Auxilio en carretera", "url": "/app.html#/operador/auxilio", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
