# ============================================================
# Variables de entorno de Netlify (Site settings > Environment
# variables). NUNCA poner valores reales en este archivo ni en
# js/config.js — solo claves públicas van ahí.
# ============================================================

# --- Supabase (compartido entre certificación y flota) ---
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=       # secreta — solo en Netlify, nunca en el cliente

# --- Sitio ---
SITE_URL=https://operadorpro.netlify.app

# --- Stripe (certificación) ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# --- Stripe (suscripción de flota — cobro por unidad activa/mes) ---
# Mismo STRIPE_SECRET_KEY de arriba (misma cuenta de Stripe). Crea un
# precio recurrente mensual nuevo para este producto; si lo configuras
# con "Tiered pricing" (graduated/volume) en el Dashboard, Stripe aplica
# el descuento por tamaño de flota automáticamente según la cantidad de
# unidades — no hace falta lógica de tiers en el código.
STRIPE_FLEET_PRICE_ID=
# Webhook SEPARADO del de certificación (endpoint distinto, ver README):
#   /.netlify/functions/fleet-stripe-webhook
STRIPE_FLEET_WEBHOOK_SECRET=

# --- Rate limiting / caché distribuidos (recomendado en producción) ---
# Sin estas variables, rate limiting y caché usan un fallback en
# memoria de proceso (NO apto para producción con múltiples instancias).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Notificaciones WhatsApp (elegir un proveedor) ---
WHATSAPP_PROVIDER=               # "meta" | "twilio" (vacío = no-op con log)

# Meta WhatsApp Cloud API — los recordatorios son mensajes que la empresa
# inicia, así que se envían SIEMPRE por plantilla aprobada (nunca texto
# libre). Crea las plantillas en WhatsApp Manager con estos nombres exactos
# (ver README > "WhatsApp real (Meta Cloud API)"):
#   operadorpro_vencimiento_documento (3 variables)
#   operadorpro_pago_proximo (3 variables)
#   operadorpro_pago_vencido (4 variables)
WHATSAPP_META_TOKEN=              # token permanente de un System User, no el temporal de 24h
WHATSAPP_META_PHONE_ID=
WHATSAPP_META_TEMPLATE_LANG=es_MX # debe coincidir con el idioma con el que aprobaste las plantillas

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=            # ej. whatsapp:+14155238886

# --- OCR de tickets (Módulo 2: Viáticos Express) ---
GOOGLE_VISION_API_KEY=           # vacío = gasto se guarda para revisión manual
