EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id

# App Configuration
EXPO_PUBLIC_APP_NAME=OperadorPro
EXPO_PUBLIC_APP_SLUG=operadorpro

# API Endpoints (for future use)
